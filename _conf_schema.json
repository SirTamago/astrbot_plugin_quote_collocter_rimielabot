{
  "default_submit_mode": {
    "description": "默认投稿权限模式（群未单独设置时使用）",
    "type": "int",
    "hint": "0：关闭投稿；1：仅管理员可投稿；2：全体可投稿",
    "default": 0,
    "options": [0, 1, 2]
  },
  "default_cooldown": {
    "description": "戳一戳随机语录的默认冷却时间（秒）",
    "type": "int",
    "hint": "同一群聊在冷却时间内戳一戳不会再次触发语录",
    "default": 10
  },
  "poke_quote_probability": {
    "description": "被戳时发送语录的概率",
    "type": "float",
    "hint": "0~1 之间，剩余概率将发送随机趣味文本",
    "default": 0.85
  },
  "recent_window": {
    "description": "随机去重窗口大小",
    "type": "int",
    "hint": "同一星级内、最近 N 抽出现过的图片不再被抽到（每星级至少保留 1 张可抽），避免短期内连续刷到同一张；0 表示关闭去重",
    "default": 8
  },
  "rarity_weights": {
    "description": "语录星级权重（1~6 星，明日方舟同款）",
    "type": "object",
    "hint": "每次抽取先按权重决定星级、再在该星级内均匀抽图，因此权重占比就是该星级的出率；填 0 表示该星级不会被抽到。默认 6★ 2%、5★ 8%、4★ 50%、3★ 40%，2★/1★ 默认 0（只作分类保留）",
    "items": {
      "weight_6": {
        "description": "★★★★★★ 权重",
        "type": "float",
        "default": 2
      },
      "weight_5": {
