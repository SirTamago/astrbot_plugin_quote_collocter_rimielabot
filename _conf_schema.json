{
  "default_submit_mode": {
    "description": "默认投稿权限模式（群未单独设置时使用）",
    "type": "int",
    "hint": "0：关闭投稿；1：仅管理员可投稿；2：全体可投稿",
    "default": 0,
    "options": [0, 1, 2]
  },
  "default_cooldown": {
    "description": "戳一戳随机语录的默认冷却时间（秒）",
    "type": "int",
    "hint": "同一群聊在冷却时间内戳一戳不会再次触发语录",
    "default": 10
  },
  "poke_quote_probability": {
    "description": "被戳时发送语录的概率",
    "type": "float",
    "hint": "0~1 之间，剩余概率将发送随机趣味文本",
    "default": 0.85
  },
  "recent_window": {
    "description": "随机去重窗口大小",
    "type": "int",
    "hint": "同一星级内、最近 N 抽出现过的图片不再被抽到（每星级至少保留 1 张可抽），避免短期内连续刷到同一张；0 表示关闭去重",
    "default": 8
  },
  "rarity_weights": {
    "description": "语录稀有度抽取权重",
    "type": "object",
    "hint": "每次抽取先按权重决定星级、再在该星级内均匀抽图，因此权重占比就是该星级的出率；填 0 表示该星级不会被抽到。默认出率约为 3星36%、4星23%、2星18%、5星14%、1星9%",
    "items": {
      "weight_5": {
        "description": "SSSR(5) 权重",
        "type": "float",
        "default": 3
      },
      "weight_4": {
        "description": "SSR(4) 权重",
        "type": "float",
        "default": 5
      },
      "weight_3": {
        "description": "SR(3) 权重",
        "type": "float",
        "default": 8
      },
      "weight_2": {
        "description": "R(2) 权重",
        "type": "float",
        "default": 4
      },
      "weight_1": {
        "description": "新卡(1) 权重",
        "type": "float",
        "default": 2
      }
    }
  },
  "pity_config": {
    "description": "保底配置",
    "type": "object",
    "hint": "每 N 抽必出一次对应星级，0 表示禁用该等级保底。默认每 10 抽必出一次 5 星。保底只在本群存在该星级或更高星级图片时生效；否则保留计数不消耗，等有图后立即触发。",
    "items": {
      "pity_5": {
        "description": "5 星保底（每 N 抽必出）",
        "type": "int",
        "default": 10
      },
      "pity_4": {
        "description": "4 星保底",
        "type": "int",
        "default": 0
      },
      "pity_3": {
        "description": "3 星保底",
        "type": "int",
        "default": 0
      },
      "pity_2": {
        "description": "2 星保底",
        "type": "int",
        "default": 0
      },
      "pity_1": {
        "description": "1 星保底",
        "type": "int",
        "default": 0
      }
    }
  }
}